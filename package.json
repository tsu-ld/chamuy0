{
  "name": "chamuy0",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "bun build extension/background.ts extension/content.ts extension/popup.ts --outdir extension/dist --target browser",
    "test": "bun test",
    "eval": "bun dev/eval.ts",
    "lint": "eslint .",
    "depcruise": "depcruise core extension dev --config .dependency-cruiser.js",
    "knip": "knip",
    "jscpd": "jscpd .",
    "typecheck": "tsc",
    "check": "bun run typecheck && bun run lint && bun run depcruise && bun run knip && bun run jscpd && bun test"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@types/bun": "^1.4.2",
    "@types/chrome": "^0.3.0",
    "dependency-cruiser": "^18.3.1",
    "eslint": "^10.11.0",
    "jscpd": "^5.3.0",
    "knip": "^6.37.0",
    "typescript": "6"
  }
}
